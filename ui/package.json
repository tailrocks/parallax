{
  "name": "ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [],
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "graphql": "16.14.2",
    "hono": "4.13.1",
    "ip-address": "10.5.0",
    "js-yaml": "5.2.3",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "bunx --bun --no-install vite dev --port 3000",
    "build": "bunx --bun --no-install vite build",
    "preview": "bunx --bun --no-install vite preview",
    "test": "bunx --bun --no-install vitest run",
    "test:ci": "bunx --bun --no-install vitest run",
    "perf:live": "bunx --bun --no-install vitest run src/features/logs/tests/model/merge-live-logs.perf.test.ts src/features/traces/tests/model/merge-live-spans.test.ts src/platform/sse",
    "bundle:analyze": "bun run scripts/bundle-analyze.ts --check",
    "bundle:analyze:build": "bun run scripts/bundle-analyze.ts --build --check",
    "bundle:build-twice": "bun run scripts/bundle-analyze.ts --build-twice",
    "test:browser:list": "bunx --bun --no-install playwright test --list",
    "test:browser:foundation": "PARALLAX_BROWSER_MODE=foundation bunx --bun --no-install playwright test --project=foundation-chromium",
    "test:browser": "bunx --bun --no-install playwright test --project=contracts-chromium",
    "test:browser:full": "PARALLAX_BROWSER_MODE=full-stack bunx --bun --no-install playwright test --project=full-stack-chromium",
    "test:browser:cross": "PARALLAX_BROWSER_MODE=breadth bunx --bun --no-install playwright test --project=cross-firefox --project=cross-webkit --project=mobile-chromium --project=mobile-webkit",
    "test:browser:a11y": "PARALLAX_BROWSER_MODE=breadth bunx --bun --no-install playwright test --project=accessibility-chromium",
    "test:browser:visual": "PARALLAX_BROWSER_MODE=breadth bunx --bun --no-install playwright test --project=visual-chromium-linux",
    "test:browser:visual:update": "PARALLAX_BROWSER_MODE=breadth PARALLAX_VISUAL_UPDATE=1 bunx --bun --no-install playwright test --project=visual-chromium-linux --update-snapshots",
    "lint": "bun run lint:native && bun run lint:type-aware",
    "lint:native": "bun ./node_modules/oxlint/bin/oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:type-aware": "bun ./node_modules/oxlint/bin/oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "format": "bun ./node_modules/oxfmt/bin/oxfmt --write \"**/*.{ts,tsx}\" \"!src/routeTree.gen.ts\"",
    "format:list": "bun ./node_modules/oxfmt/bin/oxfmt --list-different \"**/*.{ts,tsx}\" \"!src/routeTree.gen.ts\"",
    "check": "bun ./node_modules/oxfmt/bin/oxfmt --check \"**/*.{ts,tsx}\" \"!src/routeTree.gen.ts\"",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "graphql:generate": "bunx --bun --no-install graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@graphql-typed-document-node/core": "3.2.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "@tanstack/react-virtual": "^3.14.6",
    "@toolwind/corner-shape": "^0.0.8-3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.11.1",
    "graphql": "16.14.2",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@graphql-codegen/add": "6.0.0",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/near-operation-file-preset": "5.2.1",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.0",
    "@playwright/test": "1.61.1",
    "@tanstack/devtools-vite": "^0.7.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.9.0",
    "graphql-codegen-typescript-validation-schema": "0.19.0",
    "jsdom": "^28.1.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "shadcn": "^4.13.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
