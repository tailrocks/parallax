{
  "name": "ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [],
  "overrides": {
    "undici": "7.28.0"
  },
  "scripts": {
    "dev": "bunx --bun --no-install vite dev --port 3000",
    "build": "bunx --bun --no-install vite build",
    "preview": "bunx --bun --no-install vite preview",
    "test": "bunx --bun --no-install vitest run",
    "test:ci": "bunx --bun --no-install vitest run",
    "lint": "bun run lint:native && bun run lint:type-aware",
    "lint:native": "bun ./node_modules/oxlint/bin/oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:type-aware": "bun ./node_modules/oxlint/bin/oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "format": "bunx --bun --no-install prettier --write \"**/*.{ts,tsx,js,jsx}\" \"!src/routeTree.gen.ts\"",
    "check": "bunx --bun --no-install prettier --check \"**/*.{ts,tsx,js,jsx}\" \"!src/routeTree.gen.ts\"",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "@tanstack/react-virtual": "^3.14.5",
    "@toolwind/corner-shape": "^0.0.8-3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "recharts": "^3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^28",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.11.0",
    "typescript": "7.0.2",
    "vite": "^8",
    "vitest": "^4"
  }
}
