# Rotel fan-out configuration. Env names verified against Rotel v0.2.5 and
# current backend releases on 2026-09-04.

# Receivers: bind 0.0.0.0 so the container's published ports are reachable.
ROTEL_OTLP_GRPC_ENDPOINT=0.0.0.0:4317
ROTEL_OTLP_HTTP_ENDPOINT=0.0.0.0:4318

# --- Exporters -------------------------------------------------------------
# CORE lab = backends always present in the base compose: host Parallax
# + OpenObserve. Add maple/signoz/grafana/hyperdx/sentry ONLY after that
# overlay is healthy. Sequential Rotel — a listed down sink stalls the rest.
ROTEL_EXPORTERS=parallax:otlp,openobserve:otlp
# After overlays are up (never list a down sink):
# ROTEL_EXPORTERS=parallax:otlp,openobserve:otlp,maple:otlp,signoz:otlp,grafana:otlp,hyperdx:otlp,sentry:otlp

# Parallax — the only HOST sink → host.docker.internal. Offset gRPC port 14317.
ROTEL_EXPORTER_PARALLAX_ENDPOINT=http://host.docker.internal:14317
ROTEL_EXPORTER_PARALLAX_PROTOCOL=grpc

# OpenObserve — Compose service. gRPC :5081. Ingest REQUIRES auth + org/stream
# headers (Authorization = Basic base64(email:password)).
ROTEL_EXPORTER_OPENOBSERVE_ENDPOINT=http://openobserve:5081
ROTEL_EXPORTER_OPENOBSERVE_PROTOCOL=grpc
ROTEL_EXPORTER_OPENOBSERVE_CUSTOM_HEADERS=Authorization=Basic REPLACE_ME,organization=default,stream-name=default
ROTEL_EXPORTER_OPENOBSERVE_TLS_SKIP_VERIFY=true

# Maple v0.0.21 — chDB-binary container (overlay compose.maple.yml). HTTP :4318.
ROTEL_EXPORTER_MAPLE_ENDPOINT=http://maple:4318
ROTEL_EXPORTER_MAPLE_PROTOCOL=http

# SigNoz v0.140.0 — Foundry-generated ingester (overlay compose.signoz.yml).
# The overlay remaps OTLP/HTTP to host :4321 because Rotel owns host :4317/4318.
ROTEL_EXPORTER_SIGNOZ_ENDPOINT=http://host.docker.internal:4321
ROTEL_EXPORTER_SIGNOZ_PROTOCOL=http

# Sentry — runs as its OWN vendored Compose stack (sentry/setup.sh), NOT joined
# to the lab network, so Rotel reaches it over the host bridge
# (host.docker.internal:9000 → nginx → relay). OTLP/HTTP, traces+logs only (no
# OTLP metrics). projectId + DSN public key are printed by sentry/onboard.sh —
# paste them below, add `sentry` to ROTEL_EXPORTERS + the per-signal lists, then
# restart Rotel. Verified end-to-end on Sentry v26.8.0 (2026-09-04).
ROTEL_EXPORTER_SENTRY_ENDPOINT=http://host.docker.internal:9000/api/1/integration/otlp
ROTEL_EXPORTER_SENTRY_PROTOCOL=http
ROTEL_EXPORTER_SENTRY_CUSTOM_HEADERS=x-sentry-auth=sentry sentry_key=REPLACE_ME

# Grafana LGTM — overlay compose.grafana.yml. gRPC :4317 inside the container.
ROTEL_EXPORTER_GRAFANA_ENDPOINT=http://grafana-lgtm:4317
ROTEL_EXPORTER_GRAFANA_PROTOCOL=grpc

# HyperDX ClickStack 2.37.0 — overlay compose.hyperdx.yml. gRPC :4317. Ingest
# requires the first-org API key (paste after UI onboarding).
ROTEL_EXPORTER_HYPERDX_ENDPOINT=http://hyperdx:4317
ROTEL_EXPORTER_HYPERDX_PROTOCOL=grpc
ROTEL_EXPORTER_HYPERDX_CUSTOM_HEADERS=authorization=REPLACE_ME

# rustrak and highlight are NOT Rotel OTLP exporters:
#   rustrak = Sentry envelopes (c8 / dual-emission) on :18081
#   highlight = last hobby self-host (setup-highlight.sh) or BLOCKED

# --- Per-signal fan-out (each listed exporter gets a copy) ------------------
# CORE (healthy-only):
ROTEL_EXPORTERS_TRACES=parallax,openobserve
ROTEL_EXPORTERS_LOGS=parallax,openobserve
ROTEL_EXPORTERS_METRICS=parallax,openobserve
# Full lab once each overlay is healthy. Sentry omitted from METRICS (no OTLP
# metrics). rustrak/highlight never appear here.
# ROTEL_EXPORTERS_TRACES=parallax,openobserve,maple,signoz,grafana,hyperdx,sentry
# ROTEL_EXPORTERS_LOGS=parallax,openobserve,maple,signoz,grafana,hyperdx,sentry
# ROTEL_EXPORTERS_METRICS=parallax,openobserve,maple,signoz,grafana,hyperdx
